<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes to cloud backup. Device-to-device transfer is allowed: it never leaves the user's hands. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
