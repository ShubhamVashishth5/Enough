    <!-- Lock period, friend key, typing penance -->
    <string name="lock_title">Lock period</string>
    <string name="settings_lock_summary">Lock every setting for 7, 30 or 90 days</string>
    <string name="lock_explainer">During a lock nothing can be loosened at all: no bigger budget, no apps out of the Vault, no rules switched off, and no skipping waits with a friend code, typing or a key. Tightening still works. Changes already waiting apply only once the lock ends. A lock can be made longer but never shorter.</string>
