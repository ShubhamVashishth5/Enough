    <!-- Onboarding -->
    <string name="onboarding_welcome_1">A home screen that helps you use your phone less.</string>
    <string name="onboarding_welcome_2">Distracting apps go in the Vault. They leave your home screen and search, and each open starts with a short pause that grows through the day.</string>
    <string name="onboarding_welcome_3">One daily budget covers every Vault app. Making a rule stricter is instant; making it looser waits 24 hours.</string>
    <string name="onboarding_welcome_4">Nothing leaves your phone. No account, no internet access.</string>
    <string name="onboarding_home_title">Home apps</string>
    <string name="onboarding_home_body">Pick up to %2$d tools for the home screen, in order. %1$d picked.</string>
    <string name="onboarding_vault_title">The Vault</string>
    <string name="onboarding_vault_body">Tick the apps that eat your time. Common ones are already ticked. You can add more later in Settings, at once; taking one out waits 24 hours.</string>
    <string name="onboarding_budget_body">How many minutes a day, across all Vault apps together? You can lower it at any time. Raising it later waits 24 hours.</string>
