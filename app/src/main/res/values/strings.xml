    <string name="lock_extend_days">Extend to %d days from now</string>
    <string name="lock_confirm_title">Lock for %d days?</string>
    <string name="lock_confirm_body">Until %s nothing can be loosened. This can\'t be undone or shortened.</string>
    <string name="lock_confirm">Lock</string>
    <string name="lock_refused">Locked until %s. Nothing can be loosened until then.</string>
    <string name="lock_refused_short">Not saved: a lock period is on.</string>
    <string name="pending_locked">Locked until %s. These wait until the lock ends.</string>
    <string name="pending_after_lock">Applies when the lock ends</string>
    <string name="pending_apply_now">Apply now</string>
    <string name="apply_now_title">Apply now</string>
    <string name="apply_now_explainer">Skip the rest of the wait with one of these. Each is meant to take some effort, so a weak moment still costs something.</string>
    <string name="friend_key_title">Friend key</string>
    <string name="settings_friend_key_summary">Codes a friend keeps, to skip a wait</string>
    <string name="friend_key_explainer">Make 10 one-time codes and send them to a friend. When you want a waiting change to apply now, ask them to read you one. Each code works once. The app keeps only fingerprints of them, and this screen can\'t be screenshotted.</string>
