    <!-- Permissions -->
    <string name="permissions_title">Permissions</string>
    <string name="permission_granted">On</string>
    <string name="permission_missing">Off</string>
    <string name="permission_open_settings">Open settings</string>
    <string name="permission_make_default">Make default</string>
    <string name="permission_allow">Allow</string>
    <string name="permission_open_app_info">Open app info</string>
    <string name="permission_accessibility">Accessibility</string>
    <string name="permission_accessibility_why">Sees which app comes to the front, so a Vault app opened from a notification, recents or another app still gets the pause screen. It reads what\'s on screen only where a rule you switched on needs it: inside an app with a blocked feed, a browser\'s address bar while a website is in the Vault, and Settings pages during a lock period. Nothing is stored or leaves the phone.</string>
    <string name="permission_accessibility_restricted">Installed outside the Play Store? Android 13 and later grey out this setting until you open app info, tap ⋮ and choose Allow restricted settings.</string>
    <string name="permission_home">Default home app</string>
    <string name="permission_home_why">Every unlock lands here, so Vault apps aren\'t one tap away.</string>
    <string name="permission_battery">Unrestricted battery</string>
    <string name="permission_battery_why">Stops the system from pausing the app in the background, which would switch protection off.</string>

    <string name="permission_grayscale">Grayscale (optional)</string>
    <string name="permission_grayscale_why">Turns the screen grey while a Vault app is open, which makes feeds less gripping. Android lets only a computer grant this: turn on USB debugging, connect the phone and run the command below once.</string>
    <string name="permission_copy_command">Copy command</string>

    <string name="permission_notification_access">Notification access (optional)</string>
    <string name="permission_notification_access_why">For the digest: holds non-urgent notifications and releases them three times a day. They stay on the phone. Installed outside the Play Store? Allow restricted settings in app info first, as for accessibility.</string>
    <string name="permission_post_notifications">Post notifications (optional)</string>
    <string name="permission_post_notifications_why">Lets the digest post its one summary, and tells you when a new app goes into the Vault.</string>
    <string name="permission_calendar">Calendar (optional)</string>
    <string name="permission_calendar_why">Shows your next calendar item under the clock. Nothing else is read.</string>
    <string name="permission_dnd">Do Not Disturb (optional)</string>
    <string name="permission_dnd_why">Turns on Do Not Disturb during focus sessions and puts it back afterwards.</string>

    <!-- Accessibility service -->
    <string name="accessibility_service_label">Enough: Vault gate</string>
    <string name="accessibility_service_description">Notices when a Vault app comes to the front so the pause screen can appear first. Screen content is read only where a rule you switched on needs it, such as a blocked feed inside YouTube, a browser\'s address bar for a Vault website, or Settings during a lock period. Nothing is stored and nothing leaves the phone.</string>

