    <string name="permission_accessibility">Accessibility</string>
    <string name="permission_accessibility_why">Sees which app comes to the front, so a Vault app opened from a notification, recents or another app still gets the pause screen. It reads only the app\'s name, never what\'s on screen, and nothing leaves the phone.</string>
    <string name="permission_accessibility_restricted">Installed outside the Play Store? Android 13 and later grey out this setting until you open app info, tap ⋮ and choose Allow restricted settings.</string>
    <string name="permission_home">Default home app</string>
    <string name="permission_home_why">Every unlock lands here, so Vault apps aren\'t one tap away.</string>
    <string name="permission_battery">Unrestricted battery</string>
    <string name="permission_battery_why">Stops the system from pausing the app in the background, which would switch protection off.</string>

    <!-- Accessibility service -->
    <string name="accessibility_service_label">Enough: Vault gate</string>
    <string name="accessibility_service_description">Notices when a Vault app comes to the front so the pause screen can appear first. Only the app\'s name is read. Nothing on screen is read and nothing leaves the phone.</string>

