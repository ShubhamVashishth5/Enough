    <!-- Onboarding -->
    <string name="onboarding_welcome_1">A home screen that helps you use your phone less.</string>
    <string name="onboarding_welcome_2">Distracting apps go in the Vault. They leave your home screen and search, and each open starts with a short pause that grows through the day.</string>
    <string name="onboarding_welcome_3">One daily budget covers every Vault app. Making a rule stricter is instant; making it looser waits 24 hours.</string>
    <string name="onboarding_welcome_4">Nothing leaves your phone. No account, no internet access.</string>
