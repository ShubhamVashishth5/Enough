    <!-- Uninstall guard and honest limits -->
    <string name="admin_label">Enough: uninstall guard</string>
    <string name="admin_explanation">While this is on, Android won\'t uninstall Enough until you switch it off. Enough asks for no other device controls.</string>
    <string name="admin_disable_warning">Switching this off lets Enough be uninstalled. During a lock period, this page is blocked.</string>
    <string name="permission_device_admin">Uninstall guard (optional)</string>
    <string name="permission_device_admin_why">Android won\'t uninstall the app while this is on. During a lock period the app also keeps you out of its own App info, device admin and accessibility pages, so it can\'t be switched off from there.</string>
    <string name="guard_title">Locked</string>
    <string name="honest_limits_title">Honest limits</string>
    <string name="honest_limits_intro">Enough makes cheating take effort. It can\'t make it impossible, and it won\'t pretend to:</string>
    <string name="honest_limits_safe_mode">Safe mode starts the phone without any downloaded app, this one included.</string>
    <string name="honest_limits_reset">A factory reset wipes everything, rules and all.</string>
    <string name="honest_limits_adb">A computer with USB debugging can switch off or uninstall any app.</string>
    <string name="honest_limits_clock">Changing the phone\'s clock is ignored while the phone stays on, but not across a restart.</string>
    <string name="honest_limits_screens">Feed blocking, website rules and the uninstall guard read other apps\' screens. When those apps change their design, a rule can stop working until it\'s updated.</string>
    <string name="honest_limits_battery">Some phones stop background apps to save battery. Allowing unrestricted battery on the next screen helps.</string>
    <string name="honest_limits_aim">The point is a pause between the urge and the app, not a cage.</string>

