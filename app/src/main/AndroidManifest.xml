<?xml version="1.0" encoding="utf-8"?>
<!-- Usage data never leaves the phone. INTERNET is here only for home's weather and air quality lines,
     which are off until the user switches them on and send Open-Meteo a rounded location, nothing else. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Home's weather and air quality (Open-Meteo), when switched on. Coarse location is plenty. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Swipe down on home: pull down the notification shade when the accessibility service is off. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Long-press an app: Uninstall opens the system's own confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Opens the system dialog that exempts the app from battery optimisation. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Physical key: read an NFC sticker's ID. The QR scanner library adds CAMERA. Neither is required. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- The digest: one summary notification per digest time, re-armed after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The next calendar item on the Today line, once allowed. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Long-press the clock on home to open the timer. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Focus sessions turn on Do Not Disturb, once the user allows it. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Grayscale: changes Android's colour correction. Only ADB or Shizuku can grant it. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lite protection, when accessibility is off: usage access shows which app is in front, display
         over other apps lets the pause open on top of it, and a foreground service keeps it running. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Tells whether Android's Advanced Protection took accessibility away, to say so on the Permissions screen. -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />

    <!-- Android 17 QPR2 app lock: granted to the default home app. Vault apps go behind the system's
         fingerprint lock while the gate can't see every open; each change is confirmed by the user. -->
    <uses-permission
        android:name="android.permission.LOCK_APPS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 15 Private space: the home app may list, lock and unlock it. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />

    <!-- Lets LauncherApps and PackageManager see every app with a launcher icon, plus other home apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The alarm clock, which wind-down and focus sessions always let open. -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <!-- Home's icons find the phone's own phone, messages, camera and browser apps. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".MinimiseApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Minimise">

        <activity
            android:name=".launcher.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Interventions run in their own task, so finishing one reveals the app underneath. -->
        <activity
            android:name=".intervention.ui.PauseActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.minimise.intervention" />

        <activity
            android:name=".intervention.ui.BlockedActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.minimise.intervention" />

        <activity
            android:name=".intervention.ui.TimeUpActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.minimise.intervention" />

        <activity
            android:name=".intervention.ui.NoticeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.minimise.intervention" />

        <!-- The QR scanner, allowed to turn with the phone. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <service
            android:name=".digest.DigestListener"
            android:exported="true"
            android:label="@string/digest_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".digest.DigestAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".digest.DigestBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".stats.WeeklyReportAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".stats.WeeklyReportBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".calendar.CalendarFocusAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".calendar.CalendarFocusBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The uninstall guard: an active admin can't be uninstalled. It asks for no policies. -->
        <receiver
            android:name=".guard.GuardAdminReceiver"
            android:exported="true"
            android:label="@string/admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Lite protection: polls usage access while accessibility is off. -->
        <service
            android:name=".protection.ProtectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Digital wellbeing: notices when an app the user chose to limit comes to the front, so a pause can be shown first, while the accessibility service is off." />
        </service>

        <receiver
            android:name=".protection.ProtectionBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".monitor.GateAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gate_accessibility_service" />
        </service>
    </application>

</manifest>
